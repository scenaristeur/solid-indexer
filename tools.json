[
    {
        "type": "function",
        "function": {
            "name": "create_resource",
            "description": "Crée une nouvelle resource avec un titre et un contenu au format jsonld",
            "parameters": {
                "type": "object",
                "properties": {
                    "uri": {
                        "type": "string",
                        "description": "URI de la resource à créer avec l'extension .jsonld"
                    },
                    "title": {
                        "type": "string",
                        "description": "Titre de la resource (slug)"
                    },
                    "content": {
                        "type": "object",
                        "description": "Contenu au format jsonld valide de la resource"
                    },
                    "tags": {
                        "type": "string",
                        "description": "Tags optionnels séparés par des virgules"
                    }
                },
                "required": [
                    "uri",
                    "title",
                    "content"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "read_resource",
            "description": "Lit le contenu d'une resource existante",
            "parameters": {
                "type": "object",
                "properties": {
                    "uri": {
                        "type": "string",
                        "description": "URI de la resource à lire"
                    }
                },
                "required": [
                    "uri"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "update_resource",
            "description": "Met à jour le contenu d'une resource existante au format jsonld",
            "parameters": {
                "type": "object",
                "properties": {
                    "uri": {
                        "type": "string",
                        "description": "URI de la resource à modifier avec l'extension .jsonld"
                    },
                    "new_content": {
                        "type": "string",
                        "description": "Nouveau contenu au format jsonld"
                    }
                },
                "required": [
                    "uri",
                    "new_content"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "delete_resource",
            "description": "Supprime (archive) une resource",
            "parameters": {
                "type": "object",
                "properties": {
                    "uri": {
                        "type": "string",
                        "description": "URI de la resource à supprimer"
                    }
                },
                "required": [
                    "uri"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "list_resources",
            "description": "Liste toutes les resources actives",
            "parameters": {
                "type": "object",
                "properties": {
                    "uri": {
                        "type": "string",
                        "description": "URI du container à lister"
                    }
                },
                "required": [
                    "uri"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "index",
            "description": "permet de vectoriser les resources, de les stocker dans le RAG pour une recherche plus efficace",
            "parameters": {
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "retrieve",
            "description": " rechercher et récupérer dans le RAG les resources pertinentes en fonction de la requête de l'utilisateur",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "La requete de l'utilisateur"
                    }
                },
                "required": [
                    "query"
                ]
            }
        }
    }
]